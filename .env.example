# Copy to .env and fill in ONE provider. Without a key the app uses the built-in mock LLM.
# LLM_PROVIDER: mock | gemini | openai | anthropic
LLM_PROVIDER=mock

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI: https://platform.openai.com/api-keys  (OPENAI_BASE_URL works with any OpenAI-compatible server)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Fall back to the mock LLM if the provider errors (keeps the app usable during outages)
LLM_FALLBACK_TO_MOCK=true
# rules = deterministic memory extraction only; hybrid = rules + LLM extraction (when a real LLM is set)
EXTRACTION_MODE=hybrid

# Shared Brain. docker compose overrides GRAPH_BACKEND/NEO4J_URI for the app container.
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mynaksh-dev-password
